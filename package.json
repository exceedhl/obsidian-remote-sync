{
  "name": "obsidian-s3-remote-sync",
  "version": "0.1.0",
  "description": "Native Obsidian plugin for S3 synchronization with one-way, fetch-once strategy.",
  "main": "main.js",
  "bin": {
    "obsidian-s3-sync": "dist/cli.js"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production && mkdir -p dist && cp manifest.json dist/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "s3",
    "sync"
  ],
  "author": "exceedhl",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.18",
    "obsidian": "latest",
    "tslib": "2.5.0",
    "typescript": "5.0.4",
    "vitest": "^0.31.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.450.0"
  }
}